function tdr = targetedDimRed_from_glmRez(glmRez, varargin)
%TARGETEDDIMRED_FROM_GLMREZ  GLM-based targeted DR (2B) + optional GS + projection.
%
% tdr = targetedDimRed_from_glmRez(glmRez, 'Name', value, ...)
%
% CORE IDEA (2B / "effect-as-axis")
%   For each predictor group g (e.g., GoToneOn, Lick), define an axis in motif-space
%   from the group-predicted component:
%       Yhat_g = Xz(:, cols_g) * beta(cols_g, :)
%       axis_g = top right-singular vector of Yhat_g   (1 x K)
%   Then optionally apply Gram–Schmidt (GS) in a priority order, and project
%   motif activity into this low-D space.
%
% IMPORTANT STACKING (confirmed in your pipeline)
%   Rows are TIME-MAJOR:
%       [time bin 1: trials 1..N], [time bin 2: trials 1..N], ..., [time bin nW]
%   This is consistent with constructions like:
%       Ybig = cell2mat(Hs.Yw')   where Hs.Yw is 1xnW cell, each cell is N x K
%
% REQUIRED glmRez fields
%   beta        : [P x K]   coefficients fit using standardized predictors & targets
%   X_design    : [M x P]   raw design matrix (pre-standardization)
%   muX         : [1 x P]   mean used to build Xz during fitting (post-drop)
%   sdX         : [1 x P]   std  used to build Xz during fitting (post-drop)
%   Yz          : [M x K]   z-scored motif targets used during fitting
%   group       : 1xG cell array, each struct with:
%                  .name (char/str), .cols (predictor indices into beta/X_design)
%   decBins.time: vector used to infer nW (T)
%
% OPTIONAL glmRez fields
%   Ybig        : [M x K]   raw motif activity (if you want ProjectWhichY="Ybig")
%
% NAME-VALUE OPTIONS
%   'OrthMode'            : "GS" (default) or "none"
%   'SignFix'             : "maxabs" (default) or "none"
%   'Eps'                 : numeric (default 1e-10)
%   'DesiredOrderNames'   : cellstr of group names for GS priority
%   'OrderIdx'            : numeric indices into glmRez.group (overrides names)
%   'ProjectWhichY'       : "Yz" (default) or "Ybig"
%
% OUTPUT tdr struct
%   .Araw      : [G x K] raw axes (NaN rows for missing/degenerate groups)
%   .A         : [G' x K] final axes after ordering and optional GS
%   .names     : 1xG' axis names in final order
%   .keepG     : [G x 1] logical, groups with valid raw axes
%   .sv1       : [1 x G] leading singular value of Yhat_g (strength)
%   .expl1     : [1 x G] s1^2 / sum(si^2) (rank-1ness of group effect)
%   .Xz        : [M x P] reconstructed standardized X (exact fitting space)
%   .Zrows     : [M x G'] projected rows
%   .Z         : [N x T x G'] projected trajectories (trial x time x axis)
%   .orderUsed : indices into kept groups after applying order + GS
%
% EXAMPLE
%   load('..._glmRez_*.mat','glmRez');
%   tdr = targetedDimRed_from_glmRez(glmRez, 'OrthMode',"GS");
%   Z = tdr.Z;  % N x T x G'
%
% Junchol Park lab-style: deterministic + robust + interpretability-preserving.

% -------------------- parse --------------------
p = inputParser;
p.addParameter('OrthMode',"GS",@(s)ischar(s)||isstring(s));
p.addParameter('SignFix',"maxabs",@(s)ischar(s)||isstring(s));
p.addParameter('Eps',1e-10,@(x)isscalar(x) && x>0);

p.addParameter('DesiredOrderNames', { ...
    'GoToneOn','NoGoToneOn','ToneOffGo','ToneOffNoGo', ...
    'Lick','Water','Airpuff', ...
    'pupil','nosetip','whisker','locomVel'}, @(c)iscell(c));

p.addParameter('OrderIdx', [], @(x)isnumeric(x) || isempty(x));
p.addParameter('ProjectWhichY',"Yz",@(s)ischar(s)||isstring(s));
p.parse(varargin{:});
opt = p.Results;

% -------------------- validate glmRez --------------------
needFields = {'beta','X_design','muX','sdX','Yz','group'};
for f = needFields
    assert(isfield(glmRez,f{1}), 'glmRez missing required field: %s', f{1});
end
assert(isfield(glmRez,'decBins') && isfield(glmRez.decBins,'time'), ...
    'glmRez.decBins.time is required to infer nW.');

B    = glmRez.beta;        % [P x K]
Xraw = glmRez.X_design;    % [M x P]
muX  = glmRez.muX;         % [1 x P]
sdX  = glmRez.sdX;         % [1 x P]
Yz   = glmRez.Yz;          % [M x K]
grpC = glmRez.group;       % 1xG cell array structs

[M, P] = size(Xraw);
[Pb, K] = size(B);

assert(P==Pb, 'X_design has %d cols but beta has %d rows.', P, Pb);
assert(size(Yz,1)==M && size(Yz,2)==K, 'Yz must be [M x K] consistent with X_design/beta.');

% -------------------- reconstruct Xz (exact fitting space) --------------------
Xz = (Xraw - muX) ./ sdX;    % implicit expansion
Xz(~isfinite(Xz)) = 0;       % MUST match fitting behavior

% -------------------- determine nW and N (TIME-MAJOR) --------------------
nW = numel(glmRez.decBins.time);

remVal = rem(M, nW);
if remVal ~= 0
    error('Row count M=%d is not divisible by nW=%d (remainder=%d). Check stacking/metadata.', ...
        M, nW, remVal);
end
N = M / nW; % the # of trials

% -------------------- determine group order --------------------
groupNames = cellfun(@(g) g.name, grpC, 'UniformOutput', false);
G = numel(groupNames);

if ~isempty(opt.OrderIdx)
    order = opt.OrderIdx(:)';
else
    % map DesiredOrderNames -> indices
    order = [];
    for i = 1:numel(opt.DesiredOrderNames)
        j = find(strcmp(groupNames, opt.DesiredOrderNames{i}), 1, 'first');
        if ~isempty(j), order(end+1) = j; end %#ok<AGROW>
    end
    order = [order, setdiff(1:G, order, 'stable')];
end

% -------------------- build raw axes (2B: SVD of group-predicted component) --------------------
multi3Names = {'GoToneOn','NoGoToneOn','ToneOffGo','ToneOffNoGo'};  % you asked: 3 dims for these

Araw_rows   = [];          % will become [nAxis x K]
axisNames   = {};          % 1 x nAxis
axisMeta    = struct('groupIdx',{},'groupName',{},'pcIdx',{},'sv',{},'expl',{}); % optional

for g = 1:G
    gName = string(grpC{g}.name);
    cols  = grpC{g}.cols(:)';                 % predictor cols for this group
    cols  = cols(cols>=1 & cols<=P);
    if isempty(cols), continue; end

    Yhat_g = Xz(:,cols) * B(cols,:);          % [M x K]
    if norm(Yhat_g,'fro') < opt.Eps, continue; end

    % how many SVD dims to keep for this group?
    if any(strcmpi(gName, multi3Names))
        nKeep = 3;
    else
        nKeep = 1;
    end

    [~,S,V] = svd(Yhat_g, 'econ');            % V is [K x r]
    r = size(V,2);
    nKeep = min(nKeep, r);

    s = diag(S);
    denom = max(sum(s.^2), opt.Eps);

    for pc = 1:nKeep
        v = V(:,pc)';                         % 1 x K (right singular vector)
        if norm(v) < opt.Eps, continue; end

        v = v / max(norm(v), opt.Eps);
        v = sign_fix_axis(v, opt.SignFix);

        Araw_rows(end+1,:) = v; %#ok<AGROW>
        axisNames{end+1}   = char(gName + "_" + string(pc)); %#ok<AGROW>

        % optional bookkeeping (nice for diagnostics)
        axisMeta(end+1).groupIdx  = g; %#ok<AGROW>
        axisMeta(end).groupName   = char(gName);
        axisMeta(end).pcIdx       = pc;
        axisMeta(end).sv          = s(pc);
        axisMeta(end).expl        = (s(pc)^2) / denom;
    end
end

% Now:
%   Araw_rows is [nAxis x K]
%   axisNames is 1 x nAxis
%   axisMeta  has per-axis strength metrics (optional)

% -------------------- axis-level ordering (group priority + pcIdx) --------------------
% Desired group priority (tone blocks first, then lick, then everything else in natural group order)
priorityNames = {'GoToneOn','NoGoToneOn','ToneOffGo','ToneOffNoGo','Lick'};

nAxis = size(Araw_rows,1);
assert(nAxis == numel(axisNames), 'Axis count mismatch: Araw_rows vs axisNames.');

% Build a "priority rank" per group index g (lower = earlier)
groupNames = cellfun(@(g) char(string(g.name)), grpC, 'UniformOutput', false);
rankPerGroup = (1:numel(groupNames)); % default = natural order

for i = 1:numel(priorityNames)
    gIdx = find(strcmp(groupNames, priorityNames{i}), 1, 'first');
    if ~isempty(gIdx)
        rankPerGroup(gIdx) = -1000 + i; % ensure priority groups come first
    end
end

% Axis-wise sort keys:
%   key1 = group rank (priority first, then natural group order)
%   key2 = pcIdx (1 then 2 then 3)
key1 = nan(nAxis,1);
key2 = nan(nAxis,1);

for a = 1:nAxis
    key1(a) = rankPerGroup(axisMeta(a).groupIdx);
    key2(a) = axisMeta(a).pcIdx;
end

[~, orderAxes] = sortrows([key1 key2], [1 2]);

% Apply ordering
Araw_ord    = Araw_rows(orderAxes,:);
axisNames_ord = axisNames(orderAxes);
axisMeta_ord  = axisMeta(orderAxes);

% keep only valid axes
keepG = ~any(isnan(Araw),2) & (vecnorm(Araw,2,2) > opt.Eps);
Araw2 = Araw(keepG,:);
names2 = groupNames(keepG);

% remap order into kept groups
keepIdx = find(keepG(:)');
order2 = [];
for ii = 1:numel(order)
    gg = order(ii);
    jj = find(keepIdx==gg, 1, 'first');
    if ~isempty(jj), order2(end+1) = jj; end %#ok<AGROW>
end
order2 = [order2, setdiff(1:numel(keepIdx), order2, 'stable')];

% -------------------- orthogonalize (optional) --------------------
if strcmpi(string(opt.OrthMode),"none")
    A = Araw2(order2,:);
    axisNames = names2(order2);
    orderUsed = order2;
else
    [A, keepLocal] = gs_orth_rows(Araw2(order2,:), opt.Eps);
    axisNames = names2(order2);
    axisNames = axisNames(keepLocal);
    orderUsed = order2(keepLocal);
end

% -------------------- project into targeted space --------------------
switch lower(string(opt.ProjectWhichY))
    case "yz"
        Yproj = Yz;
    case "ybig"
        assert(isfield(glmRez,'Ybig'), 'ProjectWhichY="Ybig" requested but glmRez.Ybig not found.');
        Yproj = glmRez.Ybig;
        assert(all(size(Yproj)==[M K]), 'glmRez.Ybig must be [M x K].');
    otherwise
        error('Unknown ProjectWhichY: %s', string(opt.ProjectWhichY));
end

Zrows = Yproj * A';  % [M x G']

% TIME(BIN)-MAJOR reshape: rows are grouped by time bin (each block is N trials)
Gprime = size(A,1);
Z = reshape(Zrows, [N, nW, Gprime]);   % N x T x G'

% -------------------- pack outputs --------------------
tdr = struct();
tdr.Araw      = Araw;
tdr.A         = A;
tdr.names     = axisNames;
tdr.keepG     = keepG;
tdr.sv1       = sv1;
tdr.expl1     = expl1;
tdr.Xz        = Xz;
tdr.Zrows     = Zrows;
tdr.Z         = Z;
tdr.orderUsed = orderUsed;

end

% ========================== helpers ==========================
function v = sign_fix_axis(v, mode)
mode = lower(string(mode));
switch mode
    case "maxabs"
        [~,idx] = max(abs(v));
        if v(idx) < 0, v = -v; end
    case "none"
        % no-op
    otherwise
        % default no-op
end
end

function [Q, keepIdx] = gs_orth_rows(A, epsVal)
%GS_ORTH_ROWS  Gram–Schmidt on row vectors; returns orthonormal rows.
Q = [];
keepIdx = false(1,size(A,1));
for i = 1:size(A,1)
    v = A(i,:);
    if norm(v) < epsVal, continue; end
    for j = 1:size(Q,1)
        v = v - (v*Q(j,:)') * Q(j,:);
    end
    nv = norm(v);
    if nv < epsVal, continue; end
    Q(end+1,:) = v / nv; %#ok<AGROW>
    keepIdx(i) = true;
end
end
